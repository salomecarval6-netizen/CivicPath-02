# Server Environment Configuration
PORT=5000
NODE_ENV=production

# Optional Gemini API Key for dynamic natural language explanations and AI DAG generation
# If not provided or quota exceeded, CivicPath automatically uses curated deterministic UDCPR 2020 blueprints.
GEMINI_API_KEY=your_server_side_key_here

# Optional Allowed Origins for strict CORS in production (comma-separated). Leave blank for permissive CORS.
# ALLOWED_ORIGINS=https://your-domain.com
